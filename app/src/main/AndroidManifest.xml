<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos NaviHelper: 공식 문서(declaring-permissions) 기준. 사용하는 API에 필요한 권한만 선언한다. -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 차량(AAOS)과 일반 에뮬레이터 양쪽에 설치해 검증할 수 있도록 필수로 두지 않는다. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".app.BabyRelayApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BabyRelay">

        <!-- android.car 는 선택 라이브러리(AAOS에만 존재). CarUxRestrictions 조회에 사용한다. -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- 주행 제한 처리는 앱이 CarUxRestrictions를 직접 읽어 수행한다(가이드: DO 선언 앱의 책임). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
